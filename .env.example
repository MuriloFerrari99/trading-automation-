# Copie este arquivo para .env e preencha com suas credenciais da Alpaca.
# O arquivo .env NÃO é versionado (está no .gitignore).

# Credenciais Alpaca (Paper Trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# Guard de execução. Mantenha em false. Só mude para true conscientemente
# quando for operar com dinheiro real (e o guard de código permitir).
LIVE_TRADING=false

# Streaming de preços por WebSocket (opt-in). Ligado, o broker lê o último preço
# de um cache alimentado em tempo real (trades+quotes) em vez de bater REST a cada
# get_last_price. Desligado (padrão), opera 100% no REST. Feed IEX é grátis no paper.
ALPACA_STREAM_ENABLED=false
ALPACA_STREAM_FEED=iex
ALPACA_STREAM_MAX_AGE=5.0

# Camada de orquestração: "bus" (padrão), "local" ou "opensquad".
# "bus" fecha o loop de feedback e classifica regime por barras reais, com
# reconciliação periódica. "opensquad" requer um OrchestratorBridge concreto
# (aguardando doc/SDK — ver docs/research/05-arquitetura-agentes.md).
ORCHESTRATOR=bus

# Sinais de "smart money" (opcionais; fallback pago ao Capitol Trades).
# Capitol Trades (BFF) nao exige chave. Ver docs/research/03-smart-money-signals.md.
QUIVER_API_KEY=
UNUSUAL_WHALES_API_KEY=
